---
import { Image } from 'astro:assets'

import { Button, Collapse, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import Sponsors from '@/components/projects/Sponsors.astro'
import Sponsorship from '@/components/projects/Sponsorship.astro'
import alipay from '@/assets/alipay-qrcode.jpg'
import KeyIcon from '@/assets/icons/key.svg'
import wechat from '@/assets/wechat-qrcode.jpg'

const headings = [
  { depth: 2, slug: 'programs', text: '开源项目' },
  { depth: 2, slug: 'learnings', text: '学习笔记' },
  { depth: 2, slug: 'others', text: '其他' },
  { depth: 2, slug: 'gpg-signature', text: 'GPG 签名' },
  { depth: 2, slug: 'sponsorship', text: '赞助支持' }
]
---

<PageLayout title='项目' {headings} view>
  {/* About astro-pure */}
  <div class='not-prose flex justify-center'>
    <a
      href='/docs/advanced/about'
      target='_blank'
      class='flex items-center gap-x-3 rounded-full border bg-background px-4 py-2 text-sm shadow-sm transition-shadow hover:shadow-md'
    >
      <span class='size-2 rounded-full bg-green-400'></span>
      <p class='font-medium text-muted-foreground'>关于 Astro Theme Pure 主题项目</p>
    </a>
  </div>
  <p>GitHub 活跃记录：</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/659eb9/cworld1'
      format='svg'
      alt='GitHub 活跃记录'
      inferSize
      loading='lazy'
    />
  </p>
  <p>如果你觉得这些项目有帮助或有兴趣一起合作，欢迎赞助支持我的工作，或者联系我交流讨论。</p>
  <Button title='查看赞助方式' class='w-fit' href='#sponsorship'>
    <Icon class='size-5' name='receive-money' slot='before' />
  </Button>

  <h2 id='programs'>开源项目</h2>
  <ProjectSection
    projects={[
      {
        name: '🎨 Astro Theme Pure',
        description: '基于 Astro 构建的简洁、快速且功能强大的博客与文档主题',
        links: [
          { type: 'github', href: 'https://github.com/cworld1/astro-theme-pure' },
          { type: 'site', href: 'https://astro-pure.js.org/' },
          { type: 'doc', href: 'https://astro-pure.js.org/docs/list' },
          { type: 'release', href: 'https://www.npmjs.com/package/astro-pure' }
        ]
      },
      {
        name: '💄 PKU Art',
        description: '用于美化北京大学教学网界面的脚本',
        links: [
          { type: 'github', href: 'https://github.com/zhuozhiyongde/pku-art' },
          { type: 'site', href: 'https://github.com/zhuozhiyongde/pku-art' },
          { type: 'doc', href: 'https://docs.arthals.ink/docs/pku-art' }
        ]
      }
    ]}
  />
  <Collapse title='早期项目'>
    <ProjectSection
      projects={[
        {
          name: '🧩 rehype-autolink-headings-simple',
          description: '轻量版的 rehype-autolink-headings 插件',
          links: [
            { type: 'github', href: 'https://github.com/cworld1/rehype-autolink-headings-simple' },
            {
              type: 'release',
              href: 'https://www.npmjs.com/package/rehype-autolink-headings-simple'
            }
          ]
        },
        {
          name: 'Gaussian NB',
          description: '使用 Python 模拟朴素贝叶斯算法并进行乳腺癌概率预测',
          links: [{ type: 'github', href: 'https://github.com/cworld1/gaussian-nb' }]
        }
      ]}
    />
  </Collapse>

  <h2 id='learnings'>学习笔记</h2>
  <ProjectSection
    class='my-2'
    projects={[
      {
        name: 'R 语言学习',
        description: '关于 R 语言学习的笔记与代码示例',
        links: [
          { type: 'github', href: 'https://github.com/cworld1/r-learning' },
          { type: 'site', href: 'https://cworld1.github.io/r-learning' }
        ]
      },
      {
        name: 'CS 213 学习笔记',
        description: '计算机系统导论课程的笔记、代码与学习心得',
        links: [
          {
            type: 'github',
            href: 'https://github.com/zhuozhiyongde/Introduction-To-Computer-System-2023Fall-PKU'
          }
        ]
      }
    ]}
  />

  <h2 id='others'>其他</h2>
  <ProjectSection
    projects={[
      {
        name: 'CWorld',
        description: 'CWorld 的 GitHub 主页',
        links: [{ type: 'github', href: 'https://github.com/cworld1' }]
      },
      {
        name: 'Arthals',
        description: 'Arthals 的 GitHub 主页',
        links: [{ type: 'github', href: 'https://github.com/zhuozhiyongde' }]
      }
    ]}
  />

  <h2 id='gpg-signature'>GPG 签名</h2>
  <p>
    你可以通过核对 GPG 签名来验证我所签署文件的真实性。我的 GPG 密钥 ID 为 <code>114514</code>，你可以在
    OpenPGP 密钥服务器上查找或下载。
  </p>
  <Button href='https://keys.openpgp.org/search?q=114514' title='查看我的密钥' target='_blank'>
    <KeyIcon class='size-5' slot='before' />
  </Button>

  <h2 id='sponsorship'>赞助支持</h2>
  <p>
    国内方式：<a href='https://afdian.com/a/cworld' target='_blank'>爱发电</a>、微信或支付宝
  </p>
  <Sponsorship
    methods={[
      { name: '微信赞赏', icon: 'wechat-pay', image: wechat },
      { name: '支付宝', icon: 'alipay', image: alipay }
    ]}
  />
  <p>海外方式：<a href='https://ko-fi.com/cworld0' target='_blank'>Ko-fi</a></p>
  <p>
    赞助后欢迎留言或主动联系我。我的邮箱是：
    <code
      style='cursor: pointer'
      onclick='const m=atob(this.textContent);alert(m);window.open(`mailto:${m}`,"_blank")'
      >Y3dvcmxkMEBxcS5jb20=</code
    >
    （点击编码解码 Base64）。
  </p>
  <p>感谢以下赞助者：</p>
  <Sponsors
    progressMax={50}
    sponsors={[
      { name: 'd2be8', platform: 'Afdian', amount: 5, date: '2026-05-22' },
      { name: 'Saneko', platform: 'Wechat', amount: 188, date: '2026-02-25' },
      { name: '边缘星2020', platform: 'Afdian', amount: 20.26, date: '2026-02-17' },
      { name: 'Juyao Huang', platform: 'Wechat', amount: 5, date: '2026-01-15' },
      { name: 'hoochanlon', platform: 'Wechat', amount: 5, date: '2025-11-09' },
      { name: 'Arthals', platform: 'Wechat', amount: 50, date: '2025-11-06' },
      { name: '边缘星2020 (byx2020.com)', platform: 'Alipay', amount: 50, date: '2025-11-01' },
      { name: '小哲', platform: 'Wechat', amount: 50, date: '2025-08-19' },
      { name: 'Open1V', platform: 'Wechat', amount: 2, date: '2025-08-14' },
      { name: 'Luis Xu', platform: 'Alipay', amount: 30, date: '2025-08-03' },
      { name: '顾**', platform: 'Wechat', amount: 28, date: '2025-06-23' },
      { name: 'Hans J.Han', platform: 'Wechat', amount: 10, date: '2025-04-04' },
      { name: '**青', platform: 'Alipay', amount: 12, date: '2024-05-21' },
      { name: 'Anonymous', platform: 'Wechat', amount: 20, date: '2022-04-06' },
      { name: '华雄', platform: 'QQ', amount: 5, date: '2019-12-30' },
      { name: '◌', platform: 'QQ', amount: 3, date: '2019-12-30' },
      { name: 'C*a (酷安@暴走の蜗牛)', amount: 2, date: '2019-07-02' }
    ]}
  />
</PageLayout>

<style>
  .sponsorship-card {
    & .sponsorship-card-img {
      opacity: 0.3;
      --un-blur: blur(4px);
      filter: var(--un-blur);
    }

    &:hover {
      & .sponsorship-card-icon {
        opacity: 0;
      }
      & .sponsorship-card-img {
        opacity: 1;
        --un-blur: blur(0);
      }
    }
  }
</style>
